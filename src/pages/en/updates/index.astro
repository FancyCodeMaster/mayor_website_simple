---
import UpdatesSection from '../../../components/sections/UpdatesSection.astro';
import { pick, profile, publishedUpdates } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const locale = 'en';
const name = pick(profile.name, locale).value;
---

<BaseLayout locale={locale} title={`Latest Updates · ${name}`} description="Activities and public updates">
	<UpdatesSection locale={locale} items={publishedUpdates} showViewAll={false} />
</BaseLayout>

---
import { pick, publishedUpdates, type Locale } from '../../../lib/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
	return publishedUpdates.map((update) => ({ params: { slug: update.slug }, props: { update } }));
}

const locale: Locale = 'en';
const { update } = Astro.props;
const title = pick(update.summary, locale).value;
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'NewsArticle',
	headline: title,
	description: title,
	datePublished: update.date,
	url: new URL(`/en/updates/${update.slug}`, Astro.site ?? 'https://shyamsundardhimal.com.np').href,
	image: update.coverImage ? new URL(update.coverImage.src, Astro.site ?? 'https://shyamsundardhimal.com.np').href : undefined,
	mainEntityOfPage: new URL(`/en/updates/${update.slug}`, Astro.site ?? 'https://shyamsundardhimal.com.np').href,
};
---

<BaseLayout locale={locale} title={title} description={title} structuredData={structuredData}>
	<main class="mx-auto max-w-4xl px-5 py-16 md:px-8 md:py-24">
		<a href="/en/updates" class="text-sm font-semibold text-primary-dark hover:text-primary">← Back to updates</a>
		{update.coverImage && <img src={update.coverImage.src} alt={pick(update.coverImage.alt, locale).value} width="1600" height="900" class="mt-8 aspect-[16/9] w-full rounded-2xl object-cover" />}
		<p class="mt-8 text-sm font-semibold uppercase tracking-wide text-primary">{update.type} · {update.date}</p>
		<h1 class="mt-3 text-4xl font-black tracking-tight text-text">{title}</h1>
		<div class="mt-8 space-y-5 text-lg leading-8 text-text-muted">{update.body[locale].map((paragraph: string) => <p>{paragraph}</p>)}</div>
	</main>
</BaseLayout>

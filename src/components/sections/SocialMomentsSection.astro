---
import { pick, socialMoments, type Locale } from '../../lib/content';
import { getUi } from '../../lib/i18n';

const { locale } = Astro.props as { locale: Locale };
const ui = getUi(locale);
---

<section id="social-moments" class="scroll-mt-20 bg-bg" aria-labelledby="social-moments-title">
	<div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
		<div class="flex flex-wrap items-end justify-between gap-5">
			<div>
				<p class="text-sm font-bold uppercase tracking-[0.18em] text-primary">{ui.nav.socialMoments}</p>
				<h2 id="social-moments-title" class="mt-3 text-3xl font-bold tracking-tight text-text sm:text-4xl">{ui.socialMoments.title}</h2>
				<p class="mt-3 max-w-2xl text-text-muted">{ui.socialMoments.description}</p>
			</div>
		</div>

		<div class="social-moments-stage mt-10" aria-label={ui.socialMoments.carouselLabel}>
			<button type="button" class="social-moments-arrow" data-direction="previous" aria-label={ui.socialMoments.previous} disabled>
				<span aria-hidden="true">←</span>
			</button>
			<div class="social-moments-viewport" data-social-moments>
				<div class="social-moments-grid">
					{socialMoments.map((moment, index) => {
						const title = pick(moment.title, locale).value;
						return <article class="social-moment-card" data-index={index} data-position={index === 0 ? 'active' : index === 1 ? 'next' : 'hidden'} data-duration={moment.durationSeconds}>
							<div class="social-moment-media">
								<video class="social-moment-video" src={moment.videoUrl} playsinline preload="metadata" aria-label={title}></video>
								<div class="social-moment-shade" aria-hidden="true"></div>
																<button type="button" class="social-moment-mute" data-mute-toggle aria-label={ui.socialMoments.mute} aria-pressed="false"><span data-mute-icon aria-hidden="true">🔊</span><span class="sr-only" data-mute-label data-muted-label={ui.socialMoments.unmute} data-unmuted-label={ui.socialMoments.mute}>{ui.socialMoments.mute}</span></button>
								<div class="social-moment-copy">
									<p class="text-xs font-semibold uppercase tracking-[0.14em] text-white/75">{moment.platform}</p>
									<h3 class="mt-2 text-lg font-bold text-white">{title}</h3>
								</div>
								{moment.socialUrl ? <a class="social-moment-more" href={moment.socialUrl} target="_blank" rel="noopener noreferrer" hidden>{ui.socialMoments.seeMore}</a> : <button type="button" class="social-moment-play" data-play-toggle aria-label={ui.socialMoments.pause}><span data-play-label data-playing-label={ui.socialMoments.pause} data-paused-label={ui.socialMoments.play}>{ui.socialMoments.pause}</span></button>}
							</div>
						</article>;
					})}
				</div>
			</div>
			<button type="button" class="social-moments-arrow" data-direction="next" aria-label={ui.socialMoments.next}>
				<span aria-hidden="true">→</span>
			</button>
		</div>
	</div>
</section>

<style>
	.social-moments-stage { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) 3.5rem; align-items: center; gap: 1rem; }
	.social-moments-viewport { min-width: 0; overflow: hidden; }
	.social-moments-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr) minmax(0, 1fr); align-items: center; gap: 0.75rem; }
	.social-moment-card { min-width: 0; transition: opacity 200ms ease, transform 200ms ease; }
	.social-moment-card[data-position='hidden'] { display: none; }
	.social-moment-card[data-position='previous'] { grid-column: 1; grid-row: 1; opacity: 0.72; }
	.social-moment-card[data-position='active'] { grid-column: 2; grid-row: 1; transform: scale(1.03); z-index: 1; }
	.social-moment-card[data-position='next'] { grid-column: 3; grid-row: 1; opacity: 0.72; }
	.social-moment-media { position: relative; overflow: hidden; aspect-ratio: 9 / 16; border: 1px solid var(--color-border); border-radius: 1rem; background: var(--color-surface); }
	.social-moment-card[data-position='active'] .social-moment-media { box-shadow: 0 1.25rem 3rem rgb(15 23 42 / 0.18); }
	.social-moment-video { display: block; width: 100%; height: 100%; object-fit: cover; }
	.social-moment-shade { position: absolute; inset: 0; background: linear-gradient(to top, rgb(15 23 42 / 0.8), transparent 55%); pointer-events: none; }
	.social-moment-copy { position: absolute; inset: auto 1rem 1rem; pointer-events: none; }
	.social-moment-mute { position: absolute; top: 0.75rem; right: 0.75rem; z-index: 2; display: grid; height: 2.5rem; width: 2.5rem; place-items: center; border: 1px solid rgb(255 255 255 / 0.35); border-radius: 999px; background: rgb(15 23 42 / 0.72); color: white; font-size: 1rem; }
	.social-moment-mute:hover { background: var(--color-primary-dark); }
	.social-moment-more, .social-moment-play { position: absolute; inset: 50% auto auto 50%; z-index: 2; transform: translate(-50%, -50%); white-space: nowrap; border: 0; border-radius: 999px; background: var(--color-primary-dark); padding: 0.75rem 1rem; color: white; font-size: 0.875rem; font-weight: 700; box-shadow: 0 0.5rem 1.5rem rgb(15 23 42 / 0.3); }
	.social-moment-more:hover, .social-moment-play:hover { background: var(--color-primary); }
	.social-moments-arrow { display: inline-flex; height: 3.5rem; width: 3.5rem; align-items: center; justify-content: center; border: 1px solid var(--color-border); border-radius: 999px; background: var(--color-surface); color: var(--color-text); font-size: 1.75rem; }
	.social-moments-arrow:hover { border-color: var(--color-primary); color: var(--color-primary); }
	.social-moments-arrow:disabled { cursor: not-allowed; opacity: 0.35; }
	.social-moments-arrow:disabled:hover { border-color: var(--color-border); color: var(--color-text); }
	@media (max-width: 640px) {
		.social-moments-stage { grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem; gap: 0.5rem; }
		.social-moments-arrow { height: 2.75rem; width: 2.75rem; font-size: 1.4rem; }
		.social-moments-grid { display: block; }
		.social-moment-card { display: none; }
		.social-moment-card[data-position='active'] { display: block; width: min(100%, 18rem); margin-inline: auto; transform: none; }
		.social-moment-media { max-height: 70vh; }
	}
	@media (prefers-reduced-motion: reduce) { .social-moment-card { transition: none; } }
</style>

<script>
	const root = document.querySelector('[data-social-moments]');
	if (root) {
		const cards = [...root.querySelectorAll<HTMLElement>('[data-index]')];
		const previousButton = root.parentElement?.querySelector<HTMLButtonElement>('[data-direction="previous"]');
		const nextButton = root.parentElement?.querySelector<HTMLButtonElement>('[data-direction="next"]');
		let activeIndex = 0;
		let timer: number | undefined;
		let hasEnteredSection = false;

		const captureFirstFrame = (video: HTMLVideoElement) => {
			const capture = () => {
				if (!video.videoWidth || !video.videoHeight) return;
				try {
					const canvas = document.createElement('canvas');
					canvas.width = video.videoWidth;
					canvas.height = video.videoHeight;
					canvas.getContext('2d')?.drawImage(video, 0, 0, canvas.width, canvas.height);
					video.poster = canvas.toDataURL('image/jpeg', 0.82);
				} catch {
					// Keep the browser's first-frame preview if capture is unavailable.
				}
			};
			if (video.readyState >= 2) capture();
			else video.addEventListener('loadeddata', capture, { once: true });
		};

		const setPlayLabel = (card: HTMLElement, isPlaying: boolean) => {
			const label = card.querySelector<HTMLElement>('[data-play-label]');
			const button = card.querySelector<HTMLButtonElement>('[data-play-toggle]');
			const text = isPlaying ? label?.dataset.playingLabel : label?.dataset.pausedLabel;
			if (label && text) label.textContent = text;
			if (button && text) button.setAttribute('aria-label', text);
		};

		const setMuteLabel = (card: HTMLElement, isMuted: boolean) => {
			const label = card.querySelector<HTMLElement>('[data-mute-label]');
			const icon = card.querySelector<HTMLElement>('[data-mute-icon]');
			const button = card.querySelector<HTMLButtonElement>('[data-mute-toggle]');
			const text = isMuted ? label?.dataset.mutedLabel : label?.dataset.unmutedLabel;
			if (label && text) label.textContent = text;
			if (button && text) {
				button.setAttribute('aria-label', text);
				button.setAttribute('aria-pressed', String(isMuted));
			}
			if (icon) icon.textContent = isMuted ? '🔇' : '🔊';
		};

		const startPlayback = (card: HTMLElement) => {
			const video = card.querySelector<HTMLVideoElement>('video');
			if (!video) return;
			video.play().catch(() => setPlayLabel(card, false));
			setPlayLabel(card, true);
			if (timer !== undefined) window.clearTimeout(timer);
			timer = window.setTimeout(() => {
				video.pause();
				setPlayLabel(card, false);
				const more = card.querySelector<HTMLAnchorElement>('.social-moment-more');
				if (more) more.hidden = false;
			}, Number(card.dataset.duration) * 1000);
		};

		cards.forEach((card) => {
			const video = card.querySelector<HTMLVideoElement>('video');
			if (video) captureFirstFrame(video);
			card.querySelector<HTMLButtonElement>('[data-mute-toggle]')?.addEventListener('click', () => {
				if (!video) return;
				video.muted = !video.muted;
				setMuteLabel(card, video.muted);
			});
			if (video) setMuteLabel(card, video.muted);
			card.querySelector<HTMLButtonElement>('[data-play-toggle]')?.addEventListener('click', () => {
				if (video?.paused) startPlayback(card);
				else if (video) { video.pause(); setPlayLabel(card, false); }
			});
		});

		const update = () => {
			cards.forEach((card, index) => {
				const position = index === activeIndex ? 'active' : index === activeIndex + 1 ? 'next' : index === activeIndex - 1 ? 'previous' : 'hidden';
				card.setAttribute('data-position', position);
				const video = card.querySelector<HTMLVideoElement>('video');
				const more = card.querySelector<HTMLAnchorElement>('.social-moment-more');
				if (position !== 'active' && video) { video.pause(); video.currentTime = 0; }
				if (more) more.hidden = true;
				setPlayLabel(card, false);
			});
			if (previousButton) previousButton.disabled = activeIndex === 0;
			if (nextButton) nextButton.disabled = activeIndex === cards.length - 1;
			if (timer !== undefined) window.clearTimeout(timer);
			const activeCard = cards[activeIndex];
			if (hasEnteredSection && activeCard) startPlayback(activeCard);
		};

		previousButton?.addEventListener('click', () => { if (activeIndex > 0) { activeIndex -= 1; update(); } });
		nextButton?.addEventListener('click', () => { if (activeIndex < cards.length - 1) { activeIndex += 1; update(); } });
		update();

		const section = root.closest('section');
		if (section) {
			const observer = new IntersectionObserver(([entry]) => {
				if (entry.isIntersecting && !hasEnteredSection) {
					hasEnteredSection = true;
					const activeCard = cards[activeIndex];
					if (activeCard) startPlayback(activeCard);
					observer.disconnect();
				}
			}, { threshold: 0.35 });
			observer.observe(section);
		}
	}
</script>

---
import { profile, type Locale } from '../../lib/content';
import { getUi } from '../../lib/i18n';

const { locale } = Astro.props as { locale: Locale };
const ui = getUi(locale);
const platformNames = { facebook: 'Facebook', instagram: 'Instagram', tiktok: 'TikTok' } as const;
---

<section id="contact" class="scroll-mt-20 bg-bg" aria-labelledby="contact-title">
	<div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
		<p class="text-sm font-bold uppercase tracking-[0.18em] text-primary">{ui.nav.contact}</p>
		<h2 id="contact-title" class="mt-4 text-3xl font-black tracking-tight text-text sm:text-4xl">{ui.contact.title}</h2>
		<p class="mt-4 max-w-xl leading-7 text-text-muted">{ui.contact.description}</p>
		<div class="mt-8 flex justify-center">
					<div class="flex flex-nowrap justify-center gap-4 sm:gap-5">
						{profile.socialLinks.map((social) => <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={`${platformNames[social.platform]} ${social.username}`} class="group flex size-14 shrink-0 items-center justify-center rounded-full border border-border bg-surface p-2 text-text transition hover:-translate-y-1 hover:border-primary hover:bg-surface/70 sm:size-auto sm:min-w-[11rem] sm:justify-start sm:gap-3 sm:rounded-xl sm:px-4 sm:py-3">
							<img src={social.icon} alt="" width="40" height="40" class="size-10 object-contain transition-transform group-hover:scale-105" aria-hidden="true" />
							<span class="hidden text-left sm:block">
						<span class="block text-sm font-semibold">{platformNames[social.platform]}</span>
						<span class="block text-sm text-text-muted">{social.username}</span>
					</span>
				</a>)}
			</div>
		</div>
	</div>
</section>

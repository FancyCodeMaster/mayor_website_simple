---
import { issueCategories, municipalities, type Locale } from '../../lib/content';
import { getUi } from '../../lib/i18n';

const { locale } = Astro.props as { locale: Locale };
const ui = getUi(locale);
const municipality = municipalities[0];
const municipalityName = municipality.name[locale];
const wardOptions = Array.from({ length: municipality.wardCount }, (_, index) => index + 1);
const endpoint = import.meta.env.PUBLIC_ISSUE_FORM_ENDPOINT || '#';
const politicianEmail = import.meta.env.PUBLIC_POLITICIAN_EMAIL || '';
---

<main class="bg-surface" aria-labelledby="issue-title">
	<section class="mx-auto grid max-w-6xl gap-10 px-5 py-16 md:grid-cols-[0.85fr_1.15fr] md:gap-16 md:px-8 md:py-24">
		<div class="self-start md:sticky md:top-28">
			<p class="text-sm font-bold uppercase tracking-[0.18em] text-primary">{ui.issue.eyebrow}</p>
			<h1 id="issue-title" class="mt-4 text-5xl font-black tracking-tight text-text">{ui.issue.title}</h1>
			<h2 class="mt-8 text-2xl font-bold text-text">{ui.issue.overview}</h2>
			<p class="mt-3 text-lg leading-8 text-text-muted">{ui.issue.intro}</p>
			<ul class="mt-10 flex flex-col gap-[35px]">
							<li class="flex gap-3"><img src="/images/clock.png" alt="" width="32" height="32" class="size-8 shrink-0 object-contain" aria-hidden="true" /><span><strong class="block text-sm text-text">{ui.issue.twoMinutes}</strong><span class="mt-1 block text-xs leading-5 text-text-muted">{ui.issue.shortFields}</span></span></li>
							<li class="flex gap-3"><img src="/images/anonymous.png" alt="" width="32" height="32" class="size-8 shrink-0 object-contain" aria-hidden="true" /><span><strong class="block text-sm text-text">{ui.issue.anonymousTitle}</strong><span class="mt-1 block text-xs leading-5 text-text-muted">{ui.issue.anonymousText}</span></span></li>
			</ul>
		</div>

		<form id="issue-form" action={endpoint} method="POST" data-endpoint={endpoint} data-locale={locale} data-sent-message={ui.issue.sent} data-send-failed-message={ui.issue.sendFailed} data-submit-label={ui.issue.submit} data-sending-label={ui.issue.sending} class="rounded-2xl border border-border bg-bg p-5 shadow-xl shadow-primary/5 sm:p-8">
			<input type="hidden" name="municipality" value={municipality.id} />
			<input type="hidden" name="locale" value={locale} />
			<input type="hidden" name="politicianEmail" value={politicianEmail} />
			<input type="hidden" name="formStartedAt" value="" data-form-started-at />
			<div class="absolute -left-full" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
			<div class="grid gap-5 sm:grid-cols-2">
				<div class="block sm:col-span-2">
					<span class="mb-2 block text-sm font-semibold text-text">{ui.issue.municipality}</span>
					<div class="relative">
						<input value={municipalityName} disabled class="w-full cursor-not-allowed rounded-lg border border-border bg-surface px-4 py-3 pr-12 text-text" />
						<svg class="pointer-events-none absolute right-4 top-1/2 size-5 -translate-y-1/2 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
					</div>
				</div>
				<div class="relative block" data-select>
					<label for="ward" class="mb-2 block text-sm font-semibold text-text">{ui.issue.ward}</label>
					<select id="ward" name="ward" required data-native-select class="native-select w-full rounded-lg border border-border bg-surface px-4 py-3 text-text"><option value="">—</option>{wardOptions.map((ward) => <option value={ward}>{ward}</option>)}</select>
					<button type="button" data-select-trigger class="custom-select w-full items-center justify-between rounded-lg border border-border bg-bg px-4 py-3 text-left text-text" aria-haspopup="listbox" aria-expanded="false"><span data-select-value>—</span><svg class="size-5 shrink-0 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
					<div data-select-menu hidden class="absolute z-10 mt-2 max-h-60 w-full overflow-y-auto rounded-xl border border-border bg-bg p-1 shadow-xl shadow-primary/10">
						<div role="listbox" aria-label={ui.issue.ward}>{wardOptions.map((ward) => <button type="button" role="option" aria-selected="false" data-select-option data-value={ward} class="flex w-full items-center justify-between rounded-lg px-3 py-2.5 text-left text-text hover:bg-surface"><span>{ward}</span><svg data-select-check class="hidden size-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></button>)}</div>
					</div>
				</div>
				<label class="block"><span class="mb-2 block text-sm font-semibold text-text">{ui.issue.tole}</span><input name="tole" required minlength="1" maxlength="100" placeholder={ui.issue.tolePlaceholder} class="w-full rounded-lg border border-border bg-surface px-4 py-3 text-text placeholder:text-text-muted outline-none focus:outline-none focus-visible:outline-none focus:ring-0" /></label>
				<div class="relative block sm:col-span-2" data-select>
					<label for="category" class="mb-2 block text-sm font-semibold text-text">{ui.issue.category}</label>
					<select id="category" name="category" required data-native-select class="native-select w-full rounded-lg border border-border bg-surface px-4 py-3 text-text"><option value="">—</option>{issueCategories.map((category) => <option value={category.id}>{category.name[locale]}</option>)}</select>
					<button type="button" data-select-trigger class="custom-select w-full items-center justify-between rounded-lg border border-border bg-bg px-4 py-3 text-left text-text" aria-haspopup="listbox" aria-expanded="false"><span data-select-value>—</span><svg class="size-5 shrink-0 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
					<div data-select-menu hidden class="absolute z-10 mt-2 max-h-60 w-full overflow-y-auto rounded-xl border border-border bg-bg p-1 shadow-xl shadow-primary/10">
						<div role="listbox" aria-label={ui.issue.category}>{issueCategories.map((category) => <button type="button" role="option" aria-selected="false" data-select-option data-value={category.id} class="flex w-full items-center justify-between rounded-lg px-3 py-2.5 text-left text-text hover:bg-surface"><span>{category.name[locale]}</span><svg data-select-check class="hidden size-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></button>)}</div>
					</div>
				</div>
				<label class="block sm:col-span-2"><span class="mb-2 block text-sm font-semibold text-text">{ui.issue.description}</span><textarea name="description" required minlength="20" maxlength="2000" rows="6" placeholder={ui.issue.descriptionPlaceholder} class="w-full resize-y rounded-lg border border-border bg-surface px-4 py-3 text-text placeholder:text-text-muted outline-none focus:outline-none focus-visible:outline-none focus:ring-0"></textarea></label>
				<label class="block"><span class="mb-2 block text-sm font-semibold text-text">{ui.issue.name}</span><input data-contact-field name="name" maxlength="100" placeholder={ui.issue.namePlaceholder} class="w-full rounded-lg border border-border bg-surface px-4 py-3 text-text placeholder:text-text-muted outline-none focus:outline-none focus-visible:outline-none focus:ring-0 disabled:cursor-not-allowed" /></label>
				<label class="block"><span class="mb-2 block text-sm font-semibold text-text">{ui.issue.email}</span><input data-contact-field type="email" maxlength="254" name="email" placeholder={ui.issue.emailPlaceholder} class="w-full rounded-lg border border-border bg-surface px-4 py-3 text-text placeholder:text-text-muted outline-none focus:outline-none focus-visible:outline-none focus:ring-0 disabled:cursor-not-allowed" /></label>
			</div>
			<label class="mt-5 flex cursor-pointer items-center gap-3 text-sm text-text"><input id="anonymous" type="checkbox" name="anonymous" value="true" class="size-4 accent-primary outline-none focus:ring-2 focus:ring-border" />{ui.issue.submitAnonymously}</label>
			<button type="submit" data-submit-button class="mt-6 w-full rounded-lg bg-primary-dark px-5 py-3 font-semibold text-white transition hover:bg-primary focus:outline-none focus:ring-2 focus:ring-border focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-70">{ui.issue.submit}</button>
			<p data-form-notice role="status" aria-live="polite" hidden class="fixed bottom-5 left-1/2 z-50 w-[calc(100%-2.5rem)] max-w-md -translate-x-1/2 rounded-lg border border-border bg-bg px-4 py-3 text-center text-sm text-text shadow-xl"></p>
			<p class="mt-4 text-xs leading-5 text-text-muted">{ui.issue.disclaimer}</p>
		</form>
	</section>
</main>

<style>
	#issue-form :is(input, select, textarea):focus-visible { outline: none; }
	.custom-select { display: none; }
	#issue-form[data-custom-selects] .native-select { clip: rect(0 0 0 0); clip-path: inset(50%); height: 1px; overflow: hidden; position: absolute; white-space: nowrap; width: 1px; }
	#issue-form[data-custom-selects] .custom-select { display: flex; }
	#issue-form [data-select-menu] { scrollbar-color: color-mix(in srgb, var(--color-text-muted) 45%, transparent) transparent; scrollbar-width: thin; }
	#issue-form [data-select-menu]::-webkit-scrollbar { width: 0.75rem; }
	#issue-form [data-select-menu]::-webkit-scrollbar-track { margin-block: 0.5rem; }
	#issue-form [data-select-menu]::-webkit-scrollbar-thumb { background-clip: content-box; background-color: color-mix(in srgb, var(--color-text-muted) 45%, transparent); border: 0.2rem solid transparent; border-radius: 9999px; }
	#issue-form [data-select-menu]::-webkit-scrollbar-thumb:hover { background-color: color-mix(in srgb, var(--color-text-muted) 70%, transparent); }
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('#issue-form');
	const customSelects = form?.querySelectorAll<HTMLElement>('[data-select]');

	if (form && customSelects) {
		form.dataset.customSelects = '';
		const close = (container: HTMLElement) => {
			container.querySelector<HTMLButtonElement>('[data-select-trigger]')?.setAttribute('aria-expanded', 'false');
			const menu = container.querySelector<HTMLElement>('[data-select-menu]');
			if (menu) menu.hidden = true;
		};

		customSelects.forEach((container) => {
			const nativeSelect = container.querySelector<HTMLSelectElement>('[data-native-select]');
			const trigger = container.querySelector<HTMLButtonElement>('[data-select-trigger]');
			const menu = container.querySelector<HTMLElement>('[data-select-menu]');
			const value = container.querySelector<HTMLElement>('[data-select-value]');
			const options = container.querySelectorAll<HTMLButtonElement>('[data-select-option]');
			if (!nativeSelect || !trigger || !menu || !value) return;

			const sync = () => {
				const selected = nativeSelect.selectedOptions[0];
				value.textContent = selected?.textContent || '—';
				options.forEach((option) => {
					const isSelected = option.dataset.value === nativeSelect.value;
					option.setAttribute('aria-selected', String(isSelected));
					option.querySelector<SVGElement>('[data-select-check]')?.classList.toggle('hidden', !isSelected);
				});
			};

			trigger.addEventListener('click', () => {
				const isOpen = trigger.getAttribute('aria-expanded') === 'true';
				customSelects.forEach(close);
				if (!isOpen) {
					trigger.setAttribute('aria-expanded', 'true');
					menu.hidden = false;
				}
			});
			nativeSelect.addEventListener('change', sync);
			options.forEach((option) => option.addEventListener('click', () => {
				nativeSelect.value = option.dataset.value || '';
				nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
				close(container);
				trigger.focus();
			}));
			sync();
		});

		document.addEventListener('click', (event) => {
				if (!(event.target instanceof Element) || !event.target.closest('[data-select]')) customSelects.forEach(close);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') customSelects.forEach(close);
		});
	}

	const anonymous = document.querySelector<HTMLInputElement>('#anonymous');
	const contactFields = document.querySelectorAll<HTMLInputElement>('[data-contact-field]');
	anonymous?.addEventListener('change', () => {
		contactFields.forEach((field) => {
			field.disabled = anonymous.checked;
			if (anonymous.checked) field.value = '';
		});
	});

	const startTime = form?.querySelector<HTMLInputElement>('[data-form-started-at]');
	if (startTime) startTime.value = String(Date.now());
	const notice = form?.querySelector<HTMLElement>('[data-form-notice]');
	let noticeTimeout: ReturnType<typeof setTimeout> | undefined;
	const showNotice = (message: string) => {
		if (!notice) return;
		if (noticeTimeout) clearTimeout(noticeTimeout);
		notice.textContent = message;
		notice.hidden = false;
		noticeTimeout = setTimeout(() => {
			notice.hidden = true;
		}, 6000);
	};

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!form.reportValidity()) return;

		const submitButton = form.querySelector<HTMLButtonElement>('[data-submit-button]');
		const endpoint = form.dataset.endpoint;
		if (!submitButton || !notice || !endpoint || endpoint === '#') {
			showNotice(form.dataset.sendFailedMessage || '');
			return;
		}

		submitButton.disabled = true;
		submitButton.textContent = form.dataset.sendingLabel || '';
		notice.hidden = true;

		try {
			const formData = new FormData(form);
			const body = new URLSearchParams();
			formData.forEach((value, key) => {
				if (typeof value === 'string') body.append(key, value);
			});
			await fetch(endpoint, { method: 'POST', body, mode: 'no-cors' });
			form.reset();
			anonymous?.dispatchEvent(new Event('change'));
			form.querySelectorAll<HTMLSelectElement>('[data-native-select]').forEach((select) => select.dispatchEvent(new Event('change')));
			if (startTime) startTime.value = String(Date.now());
			showNotice(form.dataset.sentMessage || '');
		} catch {
			showNotice(form.dataset.sendFailedMessage || '');
		} finally {
			submitButton.disabled = false;
			submitButton.textContent = form.dataset.submitLabel || '';
		}
	});
</script>


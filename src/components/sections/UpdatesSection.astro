---
import { featuredUpdates, pick, type Locale, type Update } from '../../lib/content';
import { getUi } from '../../lib/i18n';

const { locale, items = featuredUpdates, showViewAll = true } = Astro.props as { locale: Locale; items?: Update[]; showViewAll?: boolean };
const ui = getUi(locale);
const localePrefix = locale === 'en' ? '/en' : '';
const formatDate = (date: string) => new Intl.DateTimeFormat(locale === 'en' ? 'en' : 'ne', { year: 'numeric', month: 'short', day: 'numeric' }).format(new Date(`${date}T00:00:00`));
---

<section id="updates" class="scroll-mt-20 bg-surface" aria-labelledby="updates-title">
	<div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
		<p class="text-sm font-bold uppercase tracking-[0.18em] text-primary">{ui.nav.updates}</p>
		<h2 id="updates-title" class="mt-3 text-3xl font-bold tracking-tight text-text sm:text-4xl">{ui.updates.title}</h2>
		{items.length === 0 ? <p class="mt-10 rounded-2xl border border-border bg-bg px-6 py-10 text-center text-text-muted">{ui.updates.empty}</p> : <div class="mt-10 grid gap-6 sm:grid-cols-2 md:grid-cols-3">
			{items.map((update) => {
				const title = pick(update.summary, locale).value;
				return <article class="flex flex-col overflow-hidden rounded-2xl border border-border bg-bg">
					{update.coverImage && <img src={update.coverImage.src} alt={pick(update.coverImage.alt, locale).value} width="1600" height="900" loading="lazy" class="aspect-[16/9] w-full object-cover" />}
					<div class="flex flex-1 flex-col p-5">
						<p class="text-xs font-semibold uppercase tracking-wide text-primary">{ui.updates.types[update.type]}</p>
						<h3 class="mt-2 min-h-14 line-clamp-2 text-lg font-bold leading-7 text-text">{title}</h3>
						<p class="mt-2 flex h-5 items-center text-xs text-text-muted">{formatDate(update.date)}</p>
						<a href={`${localePrefix}/updates/${update.slug}`} class="mt-auto pt-5 font-semibold text-primary-dark hover:text-primary">{ui.updates.viewUpdate} <span aria-hidden="true">→</span></a>
					</div>
				</article>;
			})}
		</div>}
		{showViewAll && <div class="mt-10 text-center">
			<a href={`${localePrefix}/updates`} class="inline-flex rounded-md bg-primary-dark px-5 py-3 font-semibold text-white hover:bg-primary">{ui.updates.viewAll}</a>
		</div>}
	</div>
</section>

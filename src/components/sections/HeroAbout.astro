---
import { pick, profile, type Locale } from '../../lib/content';
import { getUi } from '../../lib/i18n';

const { locale } = Astro.props as { locale: Locale };
const ui = getUi(locale);
const name = pick(profile.name, locale).value;
const title = pick(profile.title, locale).value;
const tagline = pick(profile.tagline, locale).value;
const imageAlt = pick(profile.heroImage.alt, locale).value;
---

<main id="top">
	<section class="relative overflow-hidden bg-surface" aria-label={name}>
		<div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_30%,color-mix(in_srgb,var(--color-primary)_18%,transparent),transparent_43%)]" aria-hidden="true"></div>

		<div class="relative mx-auto min-h-[38rem] max-w-6xl px-5 py-12 md:grid md:grid-cols-2 md:items-center md:gap-10 md:px-8 md:py-24">
			<div class="md:hidden">
				<div class="relative mx-auto flex h-[23rem] max-w-sm items-end justify-center sm:h-[29rem]">
					<span class:list={[
						'absolute top-1/2 -translate-y-1/2 font-black leading-none tracking-[-0.08em] text-primary/30 drop-shadow-[0_0_1rem_color-mix(in_srgb,var(--color-primary)_20%,transparent)]',
												locale === 'en'
													? 'left-1/2 w-full -translate-x-1/2 whitespace-nowrap text-center text-[clamp(2rem,8vw,4.5rem)]'
													: 'inset-x-0 text-center text-[clamp(3rem,15vw,6rem)]'
					]} aria-hidden="true">{name}</span>
					<div class="absolute bottom-4 h-60 w-60 rounded-full bg-primary/15 blur-3xl sm:h-72 sm:w-72" aria-hidden="true"></div>
					<img src={profile.heroImage.src} alt={imageAlt} width="1600" height="1600" fetchpriority="high" class="relative z-10 mx-auto h-[25rem] w-auto -translate-y-4 object-contain object-bottom drop-shadow-[0_1.5rem_2.5rem_color-mix(in_srgb,var(--color-primary)_22%,transparent)] sm:h-[32rem]" />
				</div>
				<div class="text-center">
					<h1 id="hero-title-mobile" class="text-4xl font-black tracking-tight text-text sm:text-5xl">{name}</h1>
					<div class="mt-5 flex flex-wrap justify-center gap-2">
						<a href="#works" class="inline-flex whitespace-nowrap rounded-md bg-primary-dark px-3 py-3 text-sm font-semibold text-white hover:bg-primary sm:px-5 sm:text-base">{ui.hero.exploreWork}</a>
						<a href={locale === 'en' ? '/en/submit-issue' : '/submit-issue'} class="inline-flex whitespace-nowrap rounded-md border border-primary-dark px-3 py-3 text-sm font-semibold text-primary-dark hover:bg-primary-dark hover:text-white sm:px-5 sm:text-base">{ui.nav.submitIssue}</a>
					</div>
					<p class="mt-5 text-xl font-semibold text-primary-dark">{title}</p>
					<p class="mx-auto mt-4 max-w-xl text-lg leading-8 text-text-muted">{tagline}</p>
				</div>
			</div>

			<div class="hidden md:block">
				<p class="mb-4 text-sm font-bold uppercase tracking-[0.18em] text-primary">{ui.hero.eyebrow}</p>
				<h1 id="hero-title-desktop" class="max-w-xl text-5xl font-black tracking-tight text-text sm:text-6xl">{name}</h1>
				<p class="mt-5 text-xl font-semibold text-primary-dark">{title}</p>
				<p class="mt-6 max-w-xl text-lg leading-8 text-text-muted">{tagline}</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href="#works" class="inline-flex rounded-md bg-primary-dark px-5 py-3 font-semibold text-white hover:bg-primary">{ui.hero.exploreWork}</a>
					<a href={locale === 'en' ? '/en/submit-issue' : '/submit-issue'} class="inline-flex rounded-md border border-primary-dark px-5 py-3 font-semibold text-primary-dark hover:bg-primary-dark hover:text-white">{ui.nav.submitIssue}</a>
				</div>
			</div>
			<div class="hidden justify-center md:flex md:justify-end">
				<div class="relative flex w-full max-w-lg items-end justify-center">
					<div class="absolute bottom-4 h-64 w-64 rounded-full bg-primary/15 blur-3xl sm:h-80 sm:w-80" aria-hidden="true"></div>
					<img src={profile.heroImage.src} alt="" width="1600" height="1600" fetchpriority="high" class="relative z-10 mx-auto h-[26rem] w-auto object-contain object-bottom drop-shadow-[0_1.5rem_2.5rem_color-mix(in_srgb,var(--color-primary)_22%,transparent)] sm:h-[34rem]" />
				</div>
			</div>
		</div>
	</section>
</main>
